{
  "name": "reviewflow",
  "version": "0.0.0",
  "private": true,
  "description": "Engineering document review and comment-resolution platform",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "check": "pnpm run check:planning",
    "check:planning": "pwsh -NoLogo -NoProfile -File ./scripts/validate-planning.ps1",
    "dev": "pnpm run dev:web",
    "dev:api": "uv --directory apps/api run uvicorn app.main:app --reload --no-access-log",
    "dev:web": "pnpm --filter @reviewflow/web dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "uv --directory apps/api run alembic upgrade head",
    "db:current": "uv --directory apps/api run alembic current",
    "build": "pnpm run build:web",
    "build:web": "pnpm --filter @reviewflow/web build",
    "lint": "pnpm run lint:api && pnpm run lint:web",
    "lint:api": "uv --directory apps/api run ruff check . && uv --directory apps/api run ruff format --check .",
    "lint:web": "pnpm --filter @reviewflow/web lint",
    "format:check": "pnpm run format:web",
    "format:web": "pnpm --filter @reviewflow/web format:check",
    "typecheck": "pnpm run typecheck:api && pnpm run typecheck:web",
    "typecheck:api": "uv --directory apps/api run mypy .",
    "typecheck:web": "pnpm --filter @reviewflow/web typecheck",
    "test": "pnpm run test:api && pnpm run test:web",
    "test:api": "uv --directory apps/api run pytest",
    "test:api:unit": "uv --directory apps/api run pytest -m \"not integration\"",
    "test:api:integration": "uv --directory apps/api run pytest -m integration",
    "test:web": "pnpm --filter @reviewflow/web test"
  }
}
