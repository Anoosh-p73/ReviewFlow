{
  "name": "reviewflow",
  "version": "0.0.0",
  "private": true,
  "description": "Engineering document review and comment-resolution platform",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "check": "pnpm run check:planning",
    "check:planning": "pwsh -NoLogo -NoProfile -File ./scripts/validate-planning.ps1",
    "dev": "pnpm run dev:api",
    "dev:api": "uv --directory apps/api run uvicorn app.main:app --reload --no-access-log",
    "build": "node ./scripts/application-not-available.mjs build",
    "lint": "pnpm run lint:api",
    "lint:api": "uv --directory apps/api run ruff check . && uv --directory apps/api run ruff format --check .",
    "typecheck": "pnpm run typecheck:api",
    "typecheck:api": "uv --directory apps/api run mypy .",
    "test": "pnpm run test:api",
    "test:api": "uv --directory apps/api run pytest"
  }
}
