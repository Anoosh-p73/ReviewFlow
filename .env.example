# Safe local API settings; export only the values you need to override.
REVIEWFLOW_ENVIRONMENT=local
REVIEWFLOW_LOG_LEVEL=INFO
REVIEWFLOW_DATABASE_URL=postgresql+psycopg://reviewflow:reviewflow-local-only@127.0.0.1:5432/reviewflow
REVIEWFLOW_DATABASE_TIMEOUT_SECONDS=2

# Used only by the PostgreSQL integration-test fixtures. The test suite rejects
# any URL whose database name is not exactly reviewflow_test.
REVIEWFLOW_TEST_DATABASE_URL=postgresql+psycopg://reviewflow:reviewflow-local-only@127.0.0.1:5432/reviewflow_test
